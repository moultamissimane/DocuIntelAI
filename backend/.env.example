DATABASE_URL=postgresql+psycopg://docuintel:docuintel@db:5432/docuintel

# Optional: enable real Gemini embeddings + LLM synthesis. Without it, the backend
# falls back to a deterministic local embedding and a heuristic extraction/answer engine.
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004
EMBEDDING_DIM=768

CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
